<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="BrightnessAuto.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary>
                    <!-- Win11 云母底色 + Win10 控件语言: 中性灰、细描边、方角和经典强调蓝. -->
                    <ResourceDictionary.ThemeDictionaries>

                        <!-- ===== 暗色 ===== -->
                        <ResourceDictionary x:Key="Dark">
                            <Color x:Key="AppCardColor">#2C2C2C</Color>
                            <Color x:Key="AppStrokeColor">#5A5A5A</Color>
                            <!-- 云母负责窗口氛围，半透明表面负责信息层级。 -->
                            <SolidColorBrush x:Key="AppCardBrush" Color="#242424" Opacity="0.46" />
                            <SolidColorBrush x:Key="AppStrokeBrush" Color="{StaticResource AppStrokeColor}" Opacity="0.28" />
                            <SolidColorBrush x:Key="AppSubtleSurfaceBrush" Color="#303030" Opacity="0.42" />
                            <SolidColorBrush x:Key="AppTopHighlightBrush" Color="#FFFFFF" Opacity="0.10" />
                            <SolidColorBrush x:Key="AppScrimBrush" Color="#101010" Opacity="0.06" />
                            <SolidColorBrush x:Key="AppTitleBarBrush" Color="#181818" Opacity="0.40" />
                            <SolidColorBrush x:Key="AppPaneBrush" Color="#000000" Opacity="0.88" />
                            <SolidColorBrush x:Key="AppContentBrush" Color="#000000" Opacity="0.15" />
                            <!-- 收起与展开共用同一颜色，避免 NavigationView 默认刷子切换时跳色。
                                 透明度从 0.48 提到 0.92: 0.48 时侧栏会透出底下的窗口内容,
                                 中文小字与图标混在一起很难辨认. -->
                            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#141414" Opacity="0.92" />
                            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#141414" Opacity="0.92" />
                            <SolidColorBrush x:Key="AppTextBrush" Color="#F5F5F5" />
                            <SolidColorBrush x:Key="AppTextDimBrush" Color="#B5B5B5" />
                            <SolidColorBrush x:Key="AppGaugeTrackBrush" Color="#FFFFFF" Opacity="0.14" />
                            <SolidColorBrush x:Key="AppLogNormalBrush" Color="#B5B5B5" />
                            <SolidColorBrush x:Key="AppClockBoxBrush" Color="#353535" Opacity="0.44" />
                            <SolidColorBrush x:Key="AppSelectionBrush" Color="#343434" Opacity="0.94" />
                            <Color x:Key="AppShadowColor">#000000</Color>
                        </ResourceDictionary>

                        <!-- ===== 亮色 ===== -->
                        <ResourceDictionary x:Key="Light">
                            <Color x:Key="AppCardColor">#FFFFFF</Color>
                            <Color x:Key="AppStrokeColor">#D5D5D5</Color>
                            <SolidColorBrush x:Key="AppCardBrush" Color="#FFFFFF" Opacity="0.42" />
                            <SolidColorBrush x:Key="AppStrokeBrush" Color="#B8C4C4" Opacity="0.72" />
                            <SolidColorBrush x:Key="AppSubtleSurfaceBrush" Color="#FFFFFF" Opacity="0.36" />
                            <SolidColorBrush x:Key="AppTopHighlightBrush" Color="#FFFFFF" Opacity="0.82" />
                            <SolidColorBrush x:Key="AppScrimBrush" Color="#FFFFFF" Opacity="0.04" />
                            <SolidColorBrush x:Key="AppTitleBarBrush" Color="#FFFFFF" Opacity="0.38" />
                            <SolidColorBrush x:Key="AppPaneBrush" Color="#FFFFFF" Opacity="0.88" />
                            <SolidColorBrush x:Key="AppContentBrush" Color="#FFFFFF" Opacity="0.08" />
                            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#F7F7F7" Opacity="0.94" />
                            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#F7F7F7" Opacity="0.94" />
                            <SolidColorBrush x:Key="AppTextBrush" Color="#111111" />
                            <SolidColorBrush x:Key="AppTextDimBrush" Color="#575757" />
                            <SolidColorBrush x:Key="AppGaugeTrackBrush" Color="#D6D6D6" />
                            <SolidColorBrush x:Key="AppLogNormalBrush" Color="#575757" />
                            <SolidColorBrush x:Key="AppClockBoxBrush" Color="#FFFFFF" Opacity="0.38" />
                            <SolidColorBrush x:Key="AppSelectionBrush" Color="#E5E5E5" Opacity="0.94" />
                            <Color x:Key="AppShadowColor">#000000</Color>
                        </ResourceDictionary>

                    </ResourceDictionary.ThemeDictionaries>

                    <!-- 共享强调色由设置页在运行时更新，切换深浅主题时保持不变。 -->
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#0078D7" />
                    <SolidColorBrush x:Key="AppSoftAccentBrush" Color="#0078D7" Opacity="0.15" />

                    <!-- Win10 方角基调: 一次性把内建控件(按钮/滑块/导航项/弹出层)的圆角拉直 -->
                    <CornerRadius x:Key="ControlCornerRadius">3</CornerRadius>
                    <CornerRadius x:Key="OverlayCornerRadius">3</CornerRadius>
                    <!-- ===== 共享样式 (随 ThemeResource 自动适配明暗) ===== -->
                    <!-- 区块标题: Win10 里是小号、字重不夸张的灰白标题 -->
                    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="14" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Foreground" Value="{ThemeResource AppTextBrush}" />
                        <Setter Property="Margin" Value="2,0,0,8" />
                    </Style>

                    <!-- 通用卡片: 方角(3px) + 1px 细描边 + 近实底.
                         注意: 投影用的 Translation 需在各卡片上以内联属性设置,
                         Vector3 无法通过 Style Setter 的字符串赋值(会让 XAML 编译器崩溃). -->
                    <Style x:Key="AppCardStyle" TargetType="Border">
                        <Setter Property="Background" Value="{ThemeResource AppCardBrush}" />
                        <Setter Property="BorderBrush" Value="{ThemeResource AppStrokeBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="CornerRadius" Value="8" />
                        <Setter Property="Padding" Value="20,18" />
                    </Style>

                    <Style x:Key="SettingRowStyle" TargetType="Grid">
                        <Setter Property="MinHeight" Value="58" />
                        <Setter Property="Padding" Value="2,4" />
                    </Style>

                    <Style x:Key="SettingTitleStyle" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="14" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Foreground" Value="{ThemeResource AppTextBrush}" />
                    </Style>

                    <Style x:Key="SettingDescriptionStyle" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Foreground" Value="{ThemeResource AppTextDimBrush}" />
                        <Setter Property="TextWrapping" Value="Wrap" />
                    </Style>

                    <Style x:Key="AccentSwatchButtonStyle" TargetType="Button">
                        <Setter Property="Width" Value="50" />
                        <Setter Property="Height" Value="50" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="CornerRadius" Value="4" />
                        <Setter Property="BorderThickness" Value="2" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>

                    <Style x:Key="AccentGridSwatchButtonStyle" TargetType="Button">
                        <Setter Property="Width" Value="50" />
                        <Setter Property="Height" Value="50" />
                        <Setter Property="Margin" Value="0,0,4,4" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="CornerRadius" Value="3" />
                        <Setter Property="BorderThickness" Value="2" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>

                    <!-- 数字时钟单个数字格子: 方角小块 -->
                    <Style x:Key="ClockDigitStyle" TargetType="Border">
                        <Setter Property="Background" Value="{ThemeResource AppClockBoxBrush}" />
                        <Setter Property="BorderBrush" Value="{ThemeResource AppStrokeBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="CornerRadius" Value="3" />
                        <Setter Property="Width" Value="42" />
                        <Setter Property="Height" Value="54" />
                        <Setter Property="Margin" Value="3,0" />
                    </Style>

                    <!-- 时钟数字文本 -->
                    <Style x:Key="ClockDigitTextStyle" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="28" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Foreground" Value="{ThemeResource AppTextBrush}" />
                        <Setter Property="HorizontalAlignment" Value="Center" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>

                    <!-- 时钟冒号 -->
                    <Style x:Key="ClockColonStyle" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="24" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Foreground" Value="{ThemeResource AppTextDimBrush}" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Margin" Value="2,0" />
                    </Style>

                    <!-- 关于卡的信息行图标 -->
                    <Style x:Key="InfoIconStyle" TargetType="FontIcon">
                        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                        <Setter Property="FontSize" Value="14" />
                        <Setter Property="Foreground" Value="{ThemeResource AppTextDimBrush}" />
                        <Setter Property="Width" Value="22" />
                    </Style>

                    <!-- 主操作按钮: Win10 的方角实色按钮(不是 Win11 胶囊) -->
                    <Style x:Key="AppPrimaryButtonStyle" TargetType="Button">
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="CornerRadius" Value="4" />
                        <Setter Property="FontSize" Value="14" />
                        <Setter Property="Padding" Value="20,6" />
                        <Setter Property="MinWidth" Value="110" />
                        <Setter Property="Height" Value="36" />
                    </Style>

                    <!-- 关于页的信息行标签(键名列) -->
                    <Style x:Key="InfoKeyStyle" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="13" />
                        <Setter Property="Foreground" Value="{ThemeResource AppTextDimBrush}" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>

                    <!-- 关于页的信息行取值 -->
                    <Style x:Key="InfoValueStyle" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="13" />
                        <Setter Property="Foreground" Value="{ThemeResource AppTextBrush}" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
